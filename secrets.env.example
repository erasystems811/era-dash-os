# Copy this to /opt/era-control/secrets.env on the control server (chmod 600).
# Never commit the real file to git.

# General — used by every client app
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rider PWA push notifications (engine/push-notify.js) — one ERA-wide
# keypair, shared across every EBOS deployment (not a per-client secret
# the way PAYMENT_ENCRYPTION_KEY is: it identifies ERA's own push server,
# nothing client-specific). Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Control credentials — used only by this engine, not by client apps
HETZNER_TOKEN=
GITHUB_TOKEN=
# DIGITALOCEAN_TOKEN= # legacy only — needed by teardown-client.mjs if you still have old DO test clients to delete. Not used for new clients.

# DirectAdmin Login Key for DNS (erasystems.com.ng) — Go54 panel > Menu >
# DNS Management to confirm the host, or Account menu > Login Keys to
# generate. Scope it to CMD_API_DNS_CONTROL only and lock it to this
# server's IP.
DA_USERNAME=
DA_LOGIN_KEY=
DA_HOST=da17.host-ww.net:2222

# scripts/check-bot-health.mjs's WhatsApp alert sender — a copy of an
# already Meta-verified number's Cloud API credentials (Bali's, chosen so
# ops alerting isn't coupled to that business's own deploys/token
# rotation), plus the personal number that should receive the alert.
ALERT_WA_TOKEN=
ALERT_WA_PHONE_NUMBER_ID=
ALERT_RECIPIENT_PHONE=

# fixbot/server.js -- the ONLY caller allowed to hit its /webhook/ops
# endpoint must send this exact value as the x-fixbot-token header. Set to
# any long random string (e.g. `openssl rand -hex 32`); Bali's
# n8n inbound router is configured with the same value on its
# "Forward to Ops Assistant" node.
FIXBOT_WEBHOOK_TOKEN=

# Optional. scripts/lib/esf-sheet.mjs (called from create-client.mjs when
# --esf-seed is used) creates and shares each new ESF business's Google
# Sheet with this. Without it, create-client.mjs --template=esf still works
# — the business just has no Sheet yet (build schema v2.0 section 9.4 is
# opt-in, same as --whatsapp/--payment). Google Cloud Console > IAM & Admin
# > Service Accounts > (create one, enable the Sheets and Drive APIs on the
# project) > Keys > Add key > JSON — paste the ENTIRE downloaded file
# content here, minified to one line (its own private_key field already
# escapes its internal newlines as \n, so this is safe as a single .env
# value).
GOOGLE_SERVICE_ACCOUNT_JSON=
