# --- General secrets (same across every ERA client app) ---
OPENAI_API_KEY={{OPENAI_API_KEY}}
ANTHROPIC_API_KEY={{ANTHROPIC_API_KEY}}

# --- Per-app secrets (generated fresh for this client) ---
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
AUTHENTICATOR_PASSWORD={{AUTHENTICATOR_PASSWORD}}
PGRST_JWT_SECRET={{PGRST_JWT_SECRET}}
SUPABASE_SERVICE_KEY={{SUPABASE_SERVICE_KEY}}
N8N_BASIC_AUTH_PASSWORD={{N8N_BASIC_AUTH_PASSWORD}}
N8N_ENCRYPTION_KEY={{N8N_ENCRYPTION_KEY}}
DASHBOARD_SESSION_SECRET={{DASHBOARD_SESSION_SECRET}}
DASHBOARD_USER=admin
DASHBOARD_PASSWORD={{DASHBOARD_PASSWORD}}

# --- WhatsApp (Meta) — blank until `add-whatsapp.mjs` is run for this client.
# {{VAR}} (not a literal blank) so push-update.mjs -- which reads a live
# client's OWN already-deployed .env and re-renders this same template --
# actually carries a real value through instead of resetting it to blank on
# every push. A literal `KEY=` here would always win over whatever's really
# live, since render() only ever fills an actual {{...}} token. Confirmed
# live: this exact bug wiped a sibling client's WhatsApp/payment/delivery
# credentials the first time an update was pushed to it -- same template
# shape, same risk here for any client (e.g. HostelSure) with real
# Paystack keys already live. ---
META_ACCESS_TOKEN={{META_ACCESS_TOKEN}}
META_PHONE_NUMBER_ID={{META_PHONE_NUMBER_ID}}
META_WEBHOOK_VERIFY_TOKEN={{META_WEBHOOK_VERIFY_TOKEN}}

# --- Payment — blank until `add-payment.mjs` is run for this client ---
PAYMENT_PROVIDER={{PAYMENT_PROVIDER}}
PAYMENT_SECRET_KEY={{PAYMENT_SECRET_KEY}}
PAYMENT_PUBLIC_KEY={{PAYMENT_PUBLIC_KEY}}
