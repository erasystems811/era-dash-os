services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    # Raised alongside lib/db.js's DB_POOL_MAX (default 200) -- Postgres's
    # own unconfigured default (100) was the real ceiling on how many
    # customers this business could have messaging at once, not anything in
    # the app. mem_limit raised to match: each open connection costs real
    # memory, and 250m left no headroom for a much bigger pool.
    mem_limit: 1536m
    command: postgres -c max_connections=500
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: {{APP_SLUG}}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app"]
      interval: 5s
      timeout: 5s
      retries: 10
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  postgrest:
    image: postgrest/postgrest
    restart: unless-stopped
    mem_limit: 100m
    environment:
      - PGRST_DB_URI=postgres://authenticator:${AUTHENTICATOR_PASSWORD}@postgres:5432/{{APP_SLUG}}
      - PGRST_DB_SCHEMA=public
      - PGRST_JWT_SECRET=${PGRST_JWT_SECRET}
      - PGRST_DB_USE_LEGACY_GUCS=false
    depends_on:
      postgres:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  n8n:
    image: docker.n8n.io/n8nio/n8n
    restart: unless-stopped
    mem_limit: 600m
    ports:
      - "127.0.0.1:5678:5678"
    environment:
      - N8N_BASIC_AUTH_ACTIVE=true
      - N8N_BASIC_AUTH_USER=admin
      - N8N_BASIC_AUTH_PASSWORD=${N8N_BASIC_AUTH_PASSWORD}
      - N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}
      - DB_TYPE=postgresdb
      - DB_POSTGRESDB_HOST=postgres
      - DB_POSTGRESDB_PORT=5432
      - DB_POSTGRESDB_DATABASE={{APP_SLUG}}
      - DB_POSTGRESDB_USER=app
      - DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}
      - N8N_HOST={{SUBDOMAIN}}
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - N8N_EDITOR_BASE_URL=https://{{SUBDOMAIN}}/
      - WEBHOOK_URL=https://{{SUBDOMAIN}}/
      - N8N_BASE_URL=https://{{SUBDOMAIN}}
      - N8N_PROXY_HOPS=1
      - GENERIC_TIMEZONE=Africa/Lagos
      - SUPABASE_URL=https://{{SUBDOMAIN}}
      - SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - N8N_BLOCK_ENV_ACCESS_IN_NODE=false
{{WHATSAPP_N8N_ENV}}
    volumes:
      - n8n_data:/home/node/.n8n
    depends_on:
      postgres:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # Renders the invoice/receipt HTML (routes/documents.js) to a real PDF --
  # internal-only, no port published, dashboard reaches it by service name.
  # Same tool already used elsewhere in ERA's stack (Nexa/Bali) for this
  # exact job.
  gotenberg:
    image: gotenberg/gotenberg:8
    restart: unless-stopped
    mem_limit: 512m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  dashboard:
    build: ./dashboard
    restart: unless-stopped
    # Raised alongside the bigger DB pool (lib/db.js's DB_POOL_MAX) -- more
    # concurrent in-flight requests/timers held in memory at once, 150m was
    # thin headroom for that.
    mem_limit: 768m
    environment:
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_NAME={{APP_SLUG}}
      - DB_USER=app
      - DB_PASSWORD=${POSTGRES_PASSWORD}
      - SESSION_SECRET=${DASHBOARD_SESSION_SECRET}
      - EBOS_ADMIN_TOKEN=${EBOS_ADMIN_TOKEN}
      - PAYMENT_ENCRYPTION_KEY=${PAYMENT_ENCRYPTION_KEY}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - META_ACCESS_TOKEN=${META_ACCESS_TOKEN}
      - META_PHONE_NUMBER_ID=${META_PHONE_NUMBER_ID}
      - META_WEBHOOK_VERIFY_TOKEN=${META_WEBHOOK_VERIFY_TOKEN}
      - INSTAGRAM_USER_ID=${INSTAGRAM_USER_ID}
      - INSTAGRAM_ACCESS_TOKEN=${INSTAGRAM_ACCESS_TOKEN}
      - INSTAGRAM_WEBHOOK_VERIFY_TOKEN=${INSTAGRAM_WEBHOOK_VERIFY_TOKEN}
      - PAYMENT_PROVIDER=${PAYMENT_PROVIDER}
      - PAYMENT_SECRET_KEY=${PAYMENT_SECRET_KEY}
      - PAYMENT_PUBLIC_KEY=${PAYMENT_PUBLIC_KEY}
      - DELIVERY_PROVIDER=${DELIVERY_PROVIDER}
      - CHOWDECK_API_BASE=${CHOWDECK_API_BASE}
      - CHOWDECK_SECRET_KEY=${CHOWDECK_SECRET_KEY}
      - CHOWDECK_MERCHANT_REFERENCE=${CHOWDECK_MERCHANT_REFERENCE}
      - GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY}
      - VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
      - VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY}
      - PUBLIC_URL=${PUBLIC_URL}
      - PORT=3000
    depends_on:
      postgres:
        condition: service_healthy
      gotenberg:
        condition: service_started
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    mem_limit: 100m
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - n8n
      - postgrest
      - dashboard
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  postgres_data:
  n8n_data:
  caddy_data:
  caddy_config:
