# --- General secrets (same across every ERA client app) ---
OPENAI_API_KEY={{OPENAI_API_KEY}}
ANTHROPIC_API_KEY={{ANTHROPIC_API_KEY}}

# --- This deployment's own public URL, e.g. https://sunset-grill.erasystems.com.ng
# -- used to build real clickable links (invoice, receipt) inside chat
# messages, since a relative path like /documents/invoice/xyz means nothing
# on WhatsApp.
PUBLIC_URL={{PUBLIC_URL}}

# --- Per-app secrets (generated fresh for this deployment) ---
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
AUTHENTICATOR_PASSWORD={{AUTHENTICATOR_PASSWORD}}
PGRST_JWT_SECRET={{PGRST_JWT_SECRET}}
SUPABASE_SERVICE_KEY={{SUPABASE_SERVICE_KEY}}
N8N_BASIC_AUTH_PASSWORD={{N8N_BASIC_AUTH_PASSWORD}}
N8N_ENCRYPTION_KEY={{N8N_ENCRYPTION_KEY}}
DASHBOARD_SESSION_SECRET={{DASHBOARD_SESSION_SECRET}}

# --- Unused, generated for compatibility with older EBOS deployments ---
EBOS_ADMIN_TOKEN={{EBOS_ADMIN_TOKEN}}
PAYMENT_ENCRYPTION_KEY={{PAYMENT_ENCRYPTION_KEY}}

# --- WhatsApp (Meta) — blank until wired (add-whatsapp.mjs or Embedded Signup).
# {{VAR}} (not a literal blank) so push-update.mjs -- which reads a live
# client's OWN already-deployed .env and re-renders this same template --
# actually carries a real value through instead of resetting it to blank on
# every push. A literal `KEY=` here would always win over whatever's really
# live, since render() only ever fills an actual {{...}} token. Confirmed
# live: this exact bug wiped WhatsApp, Chowdeck, and (being outside this
# template at all) Paystack off era-demo the first time an update was
# pushed to it. ---
META_ACCESS_TOKEN={{META_ACCESS_TOKEN}}
META_PHONE_NUMBER_ID={{META_PHONE_NUMBER_ID}}
META_WEBHOOK_VERIFY_TOKEN={{META_WEBHOOK_VERIFY_TOKEN}}

# --- Instagram (Meta) — blank until wired. Same channel-agnostic engine
# (engine/flow.js) as WhatsApp, just a different send/webhook adapter
# (engine/instagram-send.js, engine/webhook-instagram.js) -- no bot logic
# is duplicated for this channel.
INSTAGRAM_USER_ID={{INSTAGRAM_USER_ID}}
INSTAGRAM_ACCESS_TOKEN={{INSTAGRAM_ACCESS_TOKEN}}
INSTAGRAM_WEBHOOK_VERIFY_TOKEN={{INSTAGRAM_WEBHOOK_VERIFY_TOKEN}}

# --- Payment — blank until wired (add-payment.mjs). Same {{VAR}} reasoning
# as above -- must be a real placeholder, not a literal blank, or a push
# wipes live Paystack keys.
PAYMENT_PROVIDER={{PAYMENT_PROVIDER}}
PAYMENT_SECRET_KEY={{PAYMENT_SECRET_KEY}}
PAYMENT_PUBLIC_KEY={{PAYMENT_PUBLIC_KEY}}

# --- Delivery (optional). DELIVERY_PROVIDER=chowdeck turns on real rider
# booking via Chowdeck Relay; empty (same as 'manual') and delivery stays a
# manual record + WhatsApp handoff, which always works with no setup --
# engine/delivery.js's own `=== 'chowdeck'` check treats empty exactly like
# 'manual', so a brand-new client with nothing in `vars` yet still behaves
# correctly. CHOWDECK_API_BASE empty falls back to the same real default
# (engine/delivery.js has its own `|| 'https://api.chowdeck.com'`) --
# templated so a client who DOES customize it doesn't get reset by a push.
DELIVERY_PROVIDER={{DELIVERY_PROVIDER}}
CHOWDECK_API_BASE={{CHOWDECK_API_BASE}}
CHOWDECK_SECRET_KEY={{CHOWDECK_SECRET_KEY}}
CHOWDECK_MERCHANT_REFERENCE={{CHOWDECK_MERCHANT_REFERENCE}}

# --- Geocoding (optional, only used for real Chowdeck delivery fee quotes).
GOOGLE_MAPS_API_KEY={{GOOGLE_MAPS_API_KEY}}

# --- Postgres pool size (optional). lib/db.js already defaults to 200 if
# this is unset, which is safe against this template's postgres service
# (see docker-compose.yml.template's max_connections) -- only set this to
# override that default for a specific business's server. Not a {{}} token:
# this has a real code default, no per-client secret to generate.
# DB_POOL_MAX=200
