# --- General secrets (same across every ERA client app) ---
OPENAI_API_KEY={{OPENAI_API_KEY}}
ANTHROPIC_API_KEY={{ANTHROPIC_API_KEY}}

# --- Per-app secrets (generated fresh for this deployment) ---
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
AUTHENTICATOR_PASSWORD={{AUTHENTICATOR_PASSWORD}}
PGRST_JWT_SECRET={{PGRST_JWT_SECRET}}
SUPABASE_SERVICE_KEY={{SUPABASE_SERVICE_KEY}}
N8N_BASIC_AUTH_PASSWORD={{N8N_BASIC_AUTH_PASSWORD}}
N8N_ENCRYPTION_KEY={{N8N_ENCRYPTION_KEY}}
DASHBOARD_SESSION_SECRET={{DASHBOARD_SESSION_SECRET}}

# --- EBOS-specific: this deployment holds many businesses, not one client ---
# EBOS_ADMIN_TOKEN authenticates the ERA Dash OS panel's calls into
# /admin/api/* (creating a new business). PAYMENT_ENCRYPTION_KEY encrypts
# each business's own Paystack keys at rest (see lib/payment-crypto.js) --
# there is no per-client .env to hold them the way a normal ERA client app
# would, since EBOS is one deployment serving N businesses.
EBOS_ADMIN_TOKEN={{EBOS_ADMIN_TOKEN}}
PAYMENT_ENCRYPTION_KEY={{PAYMENT_ENCRYPTION_KEY}}

# --- WhatsApp (Meta) — blank until wired (Phase 7, deferred) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
