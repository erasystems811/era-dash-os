{{SUBDOMAIN}} {
    # Chidera, 2026-09-16: "my dashboard is loading very very slow i hate
    # it" -- neither Caddy nor Express (server.js's plain express.static)
    # was compressing anything, so every page load shipped the full ~180KB
    # main JS bundle uncompressed (the same file gzips to ~58KB) with no
    # caching either (max-age=0 on a content-hashed filename that's safe to
    # cache forever), meaning a repeat visit re-downloaded the same bytes
    # from scratch every time. Both fixed here, not in Express, since Caddy
    # already sits in front of every request and does this in one line.
    encode gzip zstd

    handle_path /rest/v1/* {
        reverse_proxy postgrest:3000
    }
    handle_path /n8n/* {
        reverse_proxy n8n:5678
    }
    # Vite's own content-hash naming (index-<hash>.js) means a changed file
    # is always a new filename -- there's no staleness risk in caching
    # these forever, and doing so is most of the actual fix above.
    # header_down (not the plain `header` directive) specifically because
    # Express's own express.static already sends its own Cache-Control:
    # max-age=0 on every response -- a plain `header` here just adds a
    # second Cache-Control alongside it rather than replacing it (found
    # live testing this exact fix), which is ambiguous enough that a
    # browser can't be trusted to honor the right one. header_down inside
    # reverse_proxy operates on the upstream response specifically and
    # actually overwrites it.
    # Chidera, 2026-09-23: "make it work i have clients" -- real live bug,
    # confirmed on pomodoro: this used to apply unconditionally, to EVERY
    # response through this block including a transient 500/503 during a
    # deploy/restart window. A browser that happened to fetch a
    # content-hashed chunk during exactly that window cached the ERROR as
    # if it were the immutable, forever-cacheable success response --
    # React's lazy() then kept replaying that cached failure indefinitely,
    # long after the server-side blip was over, blanking the dashboard for
    # that browser specifically (never reproducible via curl, which never
    # hit the same poisoned window, and never fixed by any server-side
    # restart, since the poison lives in the CLIENT's cache, not the
    # server). @good scopes the header to successful responses only, so a
    # future blip is never mistaken for something to cache forever again.
    handle /assets/* {
        reverse_proxy dashboard:3000 {
            @good status 2xx
            header_down @good Cache-Control "public, max-age=31536000, immutable"
        }
    }
    handle {
        reverse_proxy dashboard:3000
    }
}
